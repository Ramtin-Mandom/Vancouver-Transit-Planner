DB_HOST=localhost
DB_PORT=5432
DB_NAME=vancouver_transit
DB_USER=transit_app
DB_PASSWORD=replace_with_a_local_password

# Production API: one prebuilt artifact and no request-time timetable SQL.
ROUTING_SNAPSHOT_PATH=data/routing_snapshot
ROUTING_SNAPSHOT_REQUIRED=true
ROUTING_SNAPSHOT_DEVELOPMENT_FALLBACK=false
ROUTING_SNAPSHOT_BUILD_MAX_RSS_MB=450
# Optimistic A* speed bound in km/h.
ROUTING_MAX_TRANSIT_SPEED_KMH=120
TRANSLINK_API_KEY=
# Optional; must retain the {api_key} placeholder.
TRANSLINK_GTFS_RT_URL=https://gtfsapi.translink.ca/v3/gtfsrealtime?apikey={api_key}
# Optional reliability policy.
RELIABILITY_MINIMUM_SAMPLES=10
RELIABILITY_EARLY_SECONDS=-120
RELIABILITY_LATE_SECONDS=300
RELIABILITY_SHRINKAGE_STRENGTH=20

# Legacy development-fallback caches (unused by the production snapshot path)
# Per API request, cache_mode=request bypasses these and reproduces the old path.
ROUTING_TRIP_CACHE_CAPACITY=10000
ROUTING_TRIP_CACHE_TTL_SECONDS=3600
ROUTING_NEGATIVE_TRIP_CACHE_TTL_SECONDS=60
ROUTING_DAILY_INDEX_CAPACITY=3
ROUTING_HEURISTIC_CACHE_CAPACITY=50000
ROUTING_PROFILE_CACHE_CAPACITY=20000
ROUTING_RESPONSE_CACHE_ENABLED=true
ROUTING_RESPONSE_CACHE_CAPACITY=256
ROUTING_RESPONSE_CACHE_TTL_SECONDS=60

# Legacy development-fallback warming (unused by the production snapshot path).
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_BLOCK_READINESS=true
CACHE_WARMUP_TODAY_INDEX=true
CACHE_WARMUP_SKYTRAIN=true
CACHE_WARMUP_TOMORROW_INDEX=false
CACHE_WARMUP_TIMEOUT_SECONDS=30
